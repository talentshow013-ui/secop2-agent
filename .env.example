# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Bot de Telegram (@BotFather) y chat autorizado
TELEGRAM_TOKEN=...
TELEGRAM_CHAT_ID=...
# Opcional: si TELEGRAM_CHAT_ID es un grupo (ID negativo), IDs de usuario autorizados a escribir, separados por coma
TELEGRAM_USER_IDS=

# Token de la API Socrata de datos.gov.co (gratis: datos.gov.co -> perfil -> Developer Settings).
# Sin token funciona pero con throttling fuerte.
SOCRATA_APP_TOKEN=...


DB_PATH=./secop.db
LOG_LEVEL=INFO
DEBUG=False
